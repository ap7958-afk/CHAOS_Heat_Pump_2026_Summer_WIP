import os
import sys
import bospy as bos
import numpy as np
import time

# control
compressorSet = "bos://localhost/dev/25/pts/1"
hotWaterSet = "bos://localhost/dev/25/pts/3"
coldWaterSet = "bos://localhost/dev/25/pts/4"
BSSWaterSet = "bos://localhost/dev/16/pts/1"
BSSFanSet = "bos://localhost/dev/15/pts/4"
valveRadPanel = "bos://localhost/dev/16/pts/3"
valveSlab = "bos://localhost/dev/16/pts/6"
valveFanCoil = "bos://localhost/dev/16/pts/5"

# read
condenserTemp = "bos://localhost/dev/25/pts/9"
condenserInletTemp = "bos://localhost/dev/25/pts/5"
condenserOutletTemp = "bos://localhost/dev/25/pts/6"
evaporatorTemp = "bos://localhost/dev/25/pts/10"
evaporatorInletTemp = "bos://localhost/dev/25/pts/7"
evaporatorOutletTemp = "bos://localhost/dev/25/pts/8"
hotWaterFlow = "bos://localhost/dev/25/pts/13"
coldWaterFlow = "bos://localhost/dev/25/pts/14"
hotTankTemp = "bos://localhost/dev/25/pts/11"
coldTankTemp = "bos://localhost/dev/25/pts/12"
COPhot = 0
COPcold = 0

def mapVal(val, inputMin, inputMax, outputMin, outputMax):
    return (val - inputMin) * (outputMax - outputMin) / (inputMax - inputMin) + outputMin

Kp = .5 # proportional gain constant
Ki = .4 # integral gain constant
Kd = .1 # derivative gain constant

turnOn = True
bos.set(hotWaterSet, 100)
bos.set(coldWaterSet, 100)
bos.set(BSSWaterSet, 6)
bos.set(BSSFanSet, 5)
time.sleep(3)

if (float(bos.get(hotWaterFlow)[hotWaterFlow]) < 4 or float(bos.get(coldWaterFlow)[coldWaterFlow]) < 4):
    print("ERROR: No water flow detected)")
    turnOn = False;
    bos.set(hotWaterSet, 0)
    bos.set(coldWaterSet, 0)

print("Priming compressor and turning on BSS valves...")

if turnOn == True:
    bos.set(compressorSet, 20)
    bos.set(valveRadPanel, 10)
    bos.set(valveSlab, 10)
    bos.set(valveFanCoil, 10)

time.sleep(5)
    
print("Starting main PID operation...")

setPoint = 18                  # temp to lower to
previousTime = time.time()     # get time before
integralError = 0              # integral/accumulated error
previousError = 0              # used to calculate change/derivative of error
currentOutput = 0
issueCount = 0

maxResult = 2 * (float(bos.get(coldTankTemp)[coldTankTemp]) - setPoint)

while (turnOn == True):
    
    # Failure conditions
    if (bos.get(hotWaterFlow)[hotWaterFlow] == '' or bos.get(coldWaterFlow)[coldWaterFlow] == ''):
        count = count + 1
        print("missed sensor")
        continue

    if (issueCount >= 1000):
        turnOn = False
        print("too many missed sensors")
        break
        
    issueCount = 0
        
    if (float(bos.get(condenserTemp)[condenserTemp]) > 50 or float(bos.get(evaporatorTemp)[evaporatorTemp]) < 5 or float(bos.get(hotWaterFlow)[hotWaterFlow]) < .5 or float(bos.get(coldWaterFlow)[coldWaterFlow]) < .5):
        turnOn = False
        break
        
    # calculate change in time
    currentTime = time.time()
    dt = currentTime - previousTime

    if (dt == 0):
        continue

    # calculate errors
    proportionalError = float(bos.get(coldTankTemp)[coldTankTemp]) - setPoint   # proportional/immediate error
    print("proportional error: " + str(proportionalError))
    if (currentOutput < 100 and currentOutput > 20):
        integralError += proportionalError * dt                         # add error
    print("integral error: " + str(integralError))
    derivativeError = (proportionalError - previousError) / dt          # use previous to calculate change
    print("derivative error: " + str(derivativeError))

    # calculate result and map outputs
    result = Kp * proportionalError + Ki * integralError + Kd * derivativeError
    print("result: " + str(result))
    output = mapVal(max(min(result, maxResult), 0), 0, maxResult, 0, 100)
    bos.set(compressorSet, int(output))
    print("output: " + str(output))
    currentOutput = int(output)

    COPhot = float(bos.get(hotWaterFlow)[hotWaterFlow]) * 4184 * (float(bos.get(condenserOutletTemp)[condenserOutletTemp]) - float(bos.get(condenserInletTemp)[condenserInletTemp]))
    COPhot = COPhot / (COPhot - float(bos.get(coldWaterFlow)[coldWaterFlow]) * 4184 * (float(bos.get(evaporatorInletTemp)[evaporatorInletTemp]) - float(bos.get(evaporatorOutletTemp)[evaporatorOutletTemp])))
    COPcold = COPhot - 1
    

    # update "previous" variables for next loop
    previousTime = currentTime
    previousError = proportionalError

if turnOn == False:
    bos.set(compressorSet, 0)
    bos.set(hotWaterSet, 0)
    bos.set(coldWaterSet, 0)
    bos.set(BSSWaterSet, 0)
    bos.set(BSSFanSet, 0)
    bos.set(valveRadPanel, 0)
    bos.set(valveSlab, 0)
    bos.set(valveFanCoil, 0)
