import os
import sys
import bospy as bos
import numpy as np
import time

# control
compressorSet = "bos://localhost/dev/24/pts/1"
waterSet = "bos://localhost/dev/24/pts/2"

def mapVal(val, inputMin, inputMax, outputMin, outputMax):
    return (val - inputMin) * (outputMax - outputMin) / (inputMax - inputMin) + outputMin

# read
condenserTemp = "bos://localhost/dev/24/pts/4"
evaporatorTemp = "bos://localhost/dev/24/pts/6"
inletTemp = "bos://localhost/dev/24/pts/7"
outletTemp = "bos://localhost/dev/24/pts/5"
waterFlow = "bos://localhost/dev/24/pts/12"
tankTemp = "bos://localhost/dev/24/pts/11"

Kp = .5 # proportional gain constant
Ki = .4 # integral gain constant
Kd = .1 # derivative gain constant

turnOn = True
bos.set(waterSet, 100)
time.sleep(3)

if (float(bos.get(waterFlow)[waterFlow]) < 4):
    print("ERROR: No water flow detected)")
    turnOn = False;
    bos.set(waterSet, 0)

print("Priming compressor...")

if turnOn == True:
    bos.set(compressorSet, 54)

time.sleep(5)
    
print("Starting main PID operation...")

setPoint = 14                  # temp to lower to
previousTime = time.time()     # get time before
integralError = 0              # integral/accumulated error
previousError = 0              # used to calculate change/derivative of error
currentOutput = 0

maxResult = 2 * (float(bos.get(tankTemp)[tankTemp]) - setPoint)

while (turnOn == True):

    # Failure conditions
    if (float(bos.get(condenserTemp)[condenserTemp]) > 50 or float(bos.get(evaporatorTemp)[evaporatorTemp]) < 5 or float(bos.get(waterFlow)[waterFlow]) < .5):
        turnOn = False
        break
        
    # calculate change in time
    currentTime = time.time()
    dt = currentTime - previousTime

    if (dt == 0):
        continue

    # calculate errors
    proportionalError = float(bos.get(tankTemp)[tankTemp]) - setPoint   # proportional/immediate error
    print("proportional error: " + str(proportionalError))
    if (currentOutput < 100 and currentOutput > 54):
        integralError += proportionalError * dt                         # add error
    print("integral error: " + str(integralError))
    derivativeError = (proportionalError - previousError) / dt          # use previous to calculate change
    print("derivative error: " + str(derivativeError))

    # calculate result and map outputs
    result = Kp * proportionalError + Ki * integralError + Kd * derivativeError
    print("result: " + str(result))
    output = mapVal(min(result, maxResult), 0, maxResult, 54, 100)
    bos.set(compressorSet, int(output))
    print("output: " + str(output))
    currentOutput = int(output)
    

    # update "previous" variables for next loop
    previousTime = currentTime
    previousError = proportionalError

if turnOn == False:
    bos.set(compressorSet, 0)
    bos.set(waterSet, 0)
